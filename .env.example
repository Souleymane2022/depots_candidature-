# Clé API Anthropic (https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-...

# === APIs de recherche d'opportunités (optionnelles) ===
# Adzuna : https://developer.adzuna.com/ (gratuit, 250 req/mois)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# France Travail (ex-Pôle Emploi) : https://francetravail.io/data/api (gratuit)
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=

# === Vault pour credentials chiffrés ===
# Si vide, master password demandé interactivement via getpass à chaque session.
# Si renseigné, déchiffrement automatique sans prompt (moins sécurisé).
JOB_AGENT_VAULT_KEY=

# === Chemins (optionnels, valeurs par défaut indiquées) ===
# JOB_AGENT_DB_PATH=data/agent.db
# JOB_AGENT_PROFILE_PATH=data/profile.json
# JOB_AGENT_EMAILS_PATH=data/emails.json
# JOB_AGENT_LOGS_DIR=data/logs
# JOB_AGENT_GENERATED_DIR=data/generated
# JOB_AGENT_CACHE_DIR=data/.cache
